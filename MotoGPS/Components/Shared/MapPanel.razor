@namespace MotoGPS.Components.Shared
@using Microsoft.JSInterop
@using MotoGPS.Models
@using MotoGPS.Services
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILocationService Location

<div id="@_mapId" class="motogps-map"></div>

<style>
.motogps-map {
    width: 100%;
    height: 100%;
    background-color: #0a0a14;
}
</style>

@code {
    private readonly string _mapId = $"motogps-map-{Guid.NewGuid():N}";
    private bool _initialized;

    [Parameter] public GeoPoint InitialCenter { get; set; } = new(48.8566, 2.3522);

    protected override void OnInitialized()
    {
        Location.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized) return;

        var start = Location.Last?.Point ?? InitialCenter;
        await JS.InvokeVoidAsync("MotoGpsMap.init", _mapId, start.Latitude, start.Longitude);
        _initialized = true;
    }

    private async void OnLocationChanged(object? sender, LocationUpdate update)
    {
        if (!_initialized) return;
        try
        {
            await JS.InvokeVoidAsync(
                "MotoGpsMap.updatePosition",
                update.Point.Latitude,
                update.Point.Longitude,
                update.HeadingDegrees);
        }
        catch (JSDisconnectedException)
        {
            // WebView torn down — stop updating.
        }
    }

    public async ValueTask DisposeAsync()
    {
        Location.LocationChanged -= OnLocationChanged;
        if (_initialized)
        {
            try { await JS.InvokeVoidAsync("MotoGpsMap.dispose"); }
            catch (JSDisconnectedException) { }
        }
    }
}
