@namespace MotoGPS.Components.Shared
@using Microsoft.JSInterop
@using MotoGPS.Models
@using MotoGPS.Services
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILocationService Location

<div id="@_mapId" class="motogps-map"></div>

<style>
.motogps-map {
    width: 100%;
    height: 100%;
}
</style>

@code {
    private readonly string _mapId = $"motogps-map-{Guid.NewGuid():N}";
    private bool _initialized;
    private IReadOnlyList<GeoPoint>? _prevRadarPositions;

    [Parameter] public GeoPoint InitialCenter { get; set; } = new(48.8566, 2.3522);
    [Parameter] public IReadOnlyList<GeoPoint>? RadarPositions { get; set; }

    protected override void OnInitialized()
    {
        Location.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized) return;

        var start = Location.Last?.Point ?? InitialCenter;
        await JS.InvokeVoidAsync("MotoGpsMap.init", _mapId, start.Latitude, start.Longitude);
        _initialized = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_initialized) return;
        if (RadarPositions == _prevRadarPositions) return;
        _prevRadarPositions = RadarPositions;

        try
        {
            object?[] args = RadarPositions is { Count: > 0 }
                ? [RadarPositions.Select(p => new { latitude = p.Latitude, longitude = p.Longitude }).ToArray()]
                : [Array.Empty<object>()];
            await JS.InvokeVoidAsync("MotoGpsMap.updateRadars", args);
        }
        catch (JSDisconnectedException) { }
    }

    public async Task DrawRouteAsync(IReadOnlyList<GeoPoint> polyline)
    {
        if (!_initialized) return;
        var coords = polyline.Select(p => new[] { p.Longitude, p.Latitude }).ToArray();
        await JS.InvokeVoidAsync("MotoGpsMap.drawRoute", coords);
    }

    public async Task ClearRouteAsync()
    {
        if (!_initialized) return;
        try { await JS.InvokeVoidAsync("MotoGpsMap.clearRoute"); }
        catch (JSDisconnectedException) { }
    }

    private async void OnLocationChanged(object? sender, LocationUpdate update)
    {
        if (!_initialized) return;
        try
        {
            await JS.InvokeVoidAsync(
                "MotoGpsMap.updatePosition",
                update.Point.Latitude,
                update.Point.Longitude,
                update.HeadingDegrees);
        }
        catch (JSDisconnectedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        Location.LocationChanged -= OnLocationChanged;
        if (_initialized)
        {
            try { await JS.InvokeVoidAsync("MotoGpsMap.dispose"); }
            catch (JSDisconnectedException) { }
        }
    }
}
